# ORVIA Configuration — copy this file to .env and customise as needed.
# All settings have sensible defaults; this file is entirely optional.
#
# Usage:
#   cp .env.example .env
#   # edit .env, then:
#   python run.py

# Absolute path to the SQLite database file.
# Default: <project_root>/data/orvia.db
# ORVIA_DATABASE_PATH=/path/to/orvia.db

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# ORVIA_LOG_LEVEL=INFO

# Enable Flask debug mode (auto-reload, verbose errors).
# NEVER set true in production.
# Default: false
# ORVIA_DEBUG=false

# Server bind host. Default: 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to expose on the local network.
# ORVIA_HOST=127.0.0.1

# Server port. Default: 5000.
# ORVIA_PORT=5000
